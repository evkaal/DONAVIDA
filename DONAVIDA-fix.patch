--- /dev/null
+++ b/deploy/donavida.service
@@ -0,0 +1,18 @@
+[Unit]
+Description=DONAVIDA backend (Go)
+After=network.target postgresql.service
+Wants=postgresql.service
+
+[Service]
+Type=simple
+User=ubuntu
+WorkingDirectory=/opt/donavida/backend
+EnvironmentFile=/opt/donavida/backend/.env
+ExecStart=/opt/donavida/backend/app
+Restart=always
+RestartSec=5
+StandardOutput=journal
+StandardError=journal
+
+[Install]
+WantedBy=multi-user.target
diff --git a/deploy/nginx-donavida.conf b/deploy/nginx-donavida.conf
new file mode 100644
index 0000000..9b31fec
--- /dev/null
+++ b/deploy/nginx-donavida.conf
@@ -0,0 +1,26 @@
+server {
+    listen 80;
+    server_name 159.173.138.239;
+
+    root /opt/donavida/frontend/dist;
+    index index.html;
+
+    location / {
+        try_files $uri $uri/ /index.html;
+    }
+
+    location /assets/ {
+        try_files $uri =404;
+        expires 7d;
+        add_header Cache-Control "public, max-age=604800";
+    }
+
+    location /api/ {
+        proxy_pass http://127.0.0.1:8080;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+    }
+}
